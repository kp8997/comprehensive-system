#!/usr/bin/env ruby

# Load the Rails application and environment
require_relative '../config/environment'
require_relative '../app/grpc/ats_server'

def main
  port = '0.0.0.0:50051'
  s = GRPC::RpcServer.new
  s.add_http2_port(port, :this_port_is_insecure)
  puts "Service B (Rails ATS) gRPC server running insecurely on #{port}"
  
  # Register the service handler
  s.handle(AtsServer.new)
  
  # Run the server
  s.run_till_terminated_or_interrupted([1, 'int', 'SIGQUIT'])
end

main
